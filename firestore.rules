rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ═══════════════════════════════════════
       LIVE SESSION (pair-coding / teaching view)
       Deploy: Firebase Console → Firestore Database → Rules → paste → Publish
       (or `firebase deploy --only firestore:rules` if you use the CLI)
    ═══════════════════════════════════════ */
    match /liveRooms/{roomId} {
      // must stay readable so the app can check a room exists / has a PIN before joining
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['createdAt','lastActivityAt','pin','public','permanent','roomName','roomIcon'])
                    && request.resource.data.createdAt is number
                    && request.resource.data.lastActivityAt is number
                    && request.resource.data.public is bool
                    && (!('permanent' in request.resource.data) || request.resource.data.permanent is bool)
                    && (!('roomName' in request.resource.data) || (request.resource.data.roomName is string && request.resource.data.roomName.size() <= 40))
                    && (!('roomIcon' in request.resource.data) || (request.resource.data.roomIcon is string && request.resource.data.roomIcon.size() <= 8))
                    && (request.resource.data.pin == null
                        || (request.resource.data.pin is string && request.resource.data.pin.size() <= 64));

      // lastActivityAt (heartbeat/chat pings) or the room's own name/icon
      // ("Server Profile") may be updated after creation
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActivityAt','roomName','roomIcon'])
                    && (!('roomName' in request.resource.data) || (request.resource.data.roomName is string && request.resource.data.roomName.size() <= 40))
                    && (!('roomIcon' in request.resource.data) || (request.resource.data.roomIcon is string && request.resource.data.roomIcon.size() <= 8));

      // clients may only remove a room once it's genuinely dead (24h+ idle)
      // AND it wasn't marked permanent — routine cleanup otherwise happens
      // server-side via the Admin SDK, which bypasses these rules entirely
      allow delete: if resource.data.lastActivityAt is number
                    && request.time.toMillis() - resource.data.lastActivityAt > 24*60*60*1000
                    && resource.data.permanent != true;

      match /participants/{pid} {
        allow read: if true;

        // PIN is enforced here, server-side: if the room has a pin (a SHA-256
        // hash, never the raw PIN), the write is rejected unless the client
        // supplied a matching pinProof — this can't be bypassed by editing
        // client JS, unlike a client-only check
        allow create: if request.resource.data.keys().hasOnly(
                          ['name','broadcasting','currentFile','code','cursorLine','updatedAt','joinedAt','pinProof','avatarImg']
                        )
                        && request.resource.data.name is string && request.resource.data.name.size() <= 60
                        && request.resource.data.broadcasting is bool
                        && request.resource.data.code is string && request.resource.data.code.size() <= 300000
                        && (!('avatarImg' in request.resource.data) || request.resource.data.avatarImg == null || (request.resource.data.avatarImg is string && request.resource.data.avatarImg.size() <= 30000))
                        && (
                             get(/databases/$(database)/documents/liveRooms/$(roomId)).data.pin == null
                             || request.resource.data.pinProof
                                == get(/databases/$(database)/documents/liveRooms/$(roomId)).data.pin
                           );

        allow update: if request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['broadcasting','currentFile','code','cursorLine','updatedAt','name','avatarImg'])
                        && request.resource.data.code is string && request.resource.data.code.size() <= 300000
                        && (!('avatarImg' in request.resource.data) || request.resource.data.avatarImg == null || (request.resource.data.avatarImg is string && request.resource.data.avatarImg.size() <= 30000));

        // no per-user auth wired up in this app (no Firebase Auth), so this
        // can't be locked to "only the owner can delete their own doc" —
        // left open so Leave Room / disconnect cleanup keeps working
        allow delete: if true;
      }

      match /messages/{mid} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['senderId','name','text','createdAt','clientTs','replyTo'])
                        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
                        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
        allow update: if false;
        allow delete: if false; // only the Admin SDK cleanup job removes old messages
      }
      match /sharedFiles/{fileId} {
        allow read: if true;
        // co-edit sync doc, one per file path being collaboratively edited.
        // Same reasoning as participants/messages above: no Firebase Auth
        // wired up, so this can't be locked to "only room members" beyond
        // knowing the room code itself.
        allow write: if request.resource.data.keys().hasOnly(['code','updatedAt','updatedBy'])
                      && request.resource.data.code is string && request.resource.data.code.size() <= 500000
                      && request.resource.data.updatedAt is number
                      && request.resource.data.updatedBy is string && request.resource.data.updatedBy.size() <= 64;
        allow delete: if false; // cleaned up alongside the room by the Admin SDK job
      }

      match /calls/{callId} {
        allow read: if true;
        // caller creates the ringing doc with the SDP offer
        allow create: if request.resource.data.keys().hasOnly(
                          ['callerId','callerName','calleeId','calleeName','offer','hasVideo','status','createdAt']
                        )
                        && request.resource.data.callerId is string && request.resource.data.callerId.size() <= 64
                        && request.resource.data.callerName is string && request.resource.data.callerName.size() <= 60
                        && request.resource.data.calleeId is string && request.resource.data.calleeId.size() <= 64
                        && request.resource.data.calleeName is string && request.resource.data.calleeName.size() <= 60
                        && request.resource.data.offer is map
                        && (!('hasVideo' in request.resource.data) || request.resource.data.hasVideo is bool)
                        && request.resource.data.status == 'ringing'
                        && request.resource.data.createdAt is number;
        // callee adds the SDP answer + flips to active; either side can flip
        // to declined/ended — no auth wired up, same tradeoff as elsewhere
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','status'])
                        && request.resource.data.status in ['ringing','active','declined','ended']
                        && (!('answer' in request.resource.data) || request.resource.data.answer is map);
        allow delete: if true; // best-effort cleanup by whichever side ends the call

        match /candidates/{candId} {
          allow read: if true;
          allow create: if request.resource.data.keys().hasOnly(['from','candidate','createdAt'])
                          && request.resource.data.from in ['caller','callee']
                          && request.resource.data.candidate is map
                          && request.resource.data.createdAt is number;
          allow update: if false;
          allow delete: if false; // cleaned up alongside the call doc by the Admin SDK job
        }
      }
    }
  }
}
